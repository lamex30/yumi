# Maintainer: lamex30 <https://github.com/lamex30>
pkgname=yumi-moth
pkgver=1.3.0
pkgrel=1
pkgdesc="A sleepy pixel-art moth girl who lives at the bottom of your Wayland screen"
arch=('any')
url="https://github.com/lamex30/yumi"
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4' 'gtk4-layer-shell')
optdepends=('swayidle: dozing off when you are away'
            'playerctl: dancing to your music'
            'networkmanager: Wi-Fi reactions'
            'grim: color picker (wlroots)'
            'slurp: color picker (wlroots)'
            'hyprpicker: color picker'
            'wl-clipboard: copying colors'
            'imagemagick: converting and compressing images'
            'ffmpeg: converting and compressing video and audio'
            'swaync: Do Not Disturb'
            'mako: Do Not Disturb'
            'dunst: Do Not Disturb')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "yumi-$pkgver"
    PREFIX=/usr DESTDIR="$pkgdir" sh install.sh
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
